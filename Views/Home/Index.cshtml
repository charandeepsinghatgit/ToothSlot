@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">
    <div class="text-center">
        <h1 class="display-4">Welcome to ToothSlot</h1>
        <p class="lead">Dental Appointment Management System</p>
        
        @if (User.Identity.IsAuthenticated)
        {
            <div class="mt-4">
                <h3>Hello, @User.Identity.Name!</h3>
                
                @if (User.IsInRole("Patient"))
                {
                    <div class="mt-4">
                        <a asp-controller="Appointments" asp-action="Index" class="btn btn-primary btn-lg me-2">
                            <i class="bi bi-calendar-check"></i> My Appointments
                        </a>
                        <a asp-controller="Appointments" asp-action="Book" class="btn btn-success btn-lg">
                            <i class="bi bi-plus-circle"></i> Book Appointment
                        </a>
                    </div>
                }
                
                @if (User.IsInRole("Dentist"))
                {
                    <div class="mt-4">
                        <a asp-controller="Dentist" asp-action="Dashboard" class="btn btn-primary btn-lg">
                            <i class="bi bi-calendar3"></i> My Schedule
                        </a>
                    </div>
                }
                
               @if (User.IsInRole("Admin"))
                {
                    <div class="mt-4">
                        <a asp-controller="Services" asp-action="Index" class="btn btn-primary btn-lg me-2">
                            <i class="bi bi-gear"></i> Manage Services
                        </a>
                        <a asp-controller="Admin" asp-action="Dentists" class="btn btn-info btn-lg me-2">
                            <i class="bi bi-people"></i> Manage Dentists
                        </a>
                        <a asp-controller="Admin" asp-action="Users" class="btn btn-warning btn-lg">
                            <i class="bi bi-person-badge"></i> Manage Users
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="mt-4">
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg me-2">
                    <i class="bi bi-person-plus"></i> Get Started
                </a>
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-box-arrow-in-right"></i> Login
                </a>
            </div>
        }
    </div>
</div>