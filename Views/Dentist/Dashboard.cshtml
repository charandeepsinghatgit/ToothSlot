@model IEnumerable<ToothSlot.Models.Appointment>

@{
    ViewData["Title"] = "Today's Schedule";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-calendar-check-fill"></i> Today's Schedule
        </h2>
        <div>
            <span class="badge bg-primary fs-6">@ViewBag.TodaysDate</span>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="alert alert-info mb-4">
            <i class="bi bi-info-circle"></i> You have <strong>@ViewBag.AppointmentCount</strong> appointment(s) today.
        </div>

        <div class="row g-4">
            @foreach (var appointment in Model)
            {
                <div class="col-md-6">
                    <div class="card h-100 border-start border-4 @(appointment.Status == "Confirmed" ? "border-success" : "border-warning")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="card-title mb-0">
                                    @appointment.Patient.FirstName @appointment.Patient.LastName
                                </h5>
                                @if (appointment.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (appointment.Status == "Confirmed")
                                {
                                    <span class="badge bg-success">Confirmed</span>
                                }
                                else if (appointment.Status == "Completed")
                                {
                                    <span class="badge bg-primary">Completed</span>
                                }
                            </div>
                            
                            <div class="mb-2">
                                <i class="bi bi-gear-fill text-primary"></i>
                                <strong>Service:</strong> @appointment.Service.Name
                            </div>
                            
                            <div class="mb-2">
                                <i class="bi bi-clock text-primary"></i>
                                <strong>Time:</strong> @appointment.StartTime.Hours:@appointment.StartTime.Minutes.ToString("00")
                            </div>
                            
                            <div class="mb-2">
                                <i class="bi bi-hourglass text-primary"></i>
                                <strong>Duration:</strong> @appointment.Service.DurationMinutes minutes
                            </div>
                            
                            @if (!string.IsNullOrEmpty(appointment.Notes))
                            {
                                <div class="mt-3">
                                    <i class="bi bi-sticky text-primary"></i>
                                    <strong>Notes:</strong>
                                    <p class="text-muted mb-0">@appointment.Notes</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-calendar-x"></i> No appointments scheduled for today.
        </div>
    }
    
    <div class="mt-4">
        <a asp-action="Upcoming" class="btn btn-outline-primary">
            <i class="bi bi-calendar-week"></i> View Upcoming Week
        </a>
    </div>
</div>