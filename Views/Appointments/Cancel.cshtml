@model ToothSlot.Models.Appointment

@{
    ViewData["Title"] = "Cancel Appointment";
}

<div class="container mt-4">
    <h2>Cancel Appointment</h2>
    <hr />
    
    <div class="alert alert-warning">
        <h4>Are you sure you want to cancel this appointment?</h4>
    </div>
    
    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Service</dt>
                <dd class="col-sm-9">@Model.Service.Name</dd>
                
                <dt class="col-sm-3">Dentist</dt>
                <dd class="col-sm-9">Dr. @Model.Dentist.FirstName @Model.Dentist.LastName</dd>
                
                <dt class="col-sm-3">Date</dt>
                <dd class="col-sm-9">@Model.AppointmentDate.ToString("MMMM dd, yyyy")</dd>
                
                <dt class="col-sm-3">Time</dt>
                <dd class="col-sm-9">@Model.StartTime.Hours:@Model.StartTime.Minutes.ToString("00")</dd>
                
                <dt class="col-sm-3">Duration</dt>
                <dd class="col-sm-9">@Model.Service.DurationMinutes minutes</dd>
                
                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">$@Model.Service.Price</dd>
                
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-warning">@Model.Status</span>
                </dd>
            </dl>
            
            <form asp-action="CancelConfirmed" method="post" class="mt-3">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-x-circle"></i> Yes, Cancel Appointment
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> No, Keep Appointment
                </a>
            </form>
        </div>
    </div>
</div>