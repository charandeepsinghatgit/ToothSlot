@model IEnumerable<ToothSlot.Models.Appointment>

@{
    ViewData["Title"] = User.IsInRole("Dentist") ? "All Appointments" : "My Appointments";
}

<div class="container mt-4">
    <h2>
        <i class="bi bi-calendar3"></i> @ViewData["Title"]
    </h2>
    <hr />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                @if (User.IsInRole("Dentist"))
                                {
                                    <th>Patient</th>
                                }
                                else
                                {
                                    <th>Dentist</th>
                                }
                                <th>Service</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Status</th>
                                @if (User.IsInRole("Patient"))
                                {
                                    <th>Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appointment in Model)
                            {
                                <tr>
                                    @if (User.IsInRole("Dentist"))
                                    {
                                        <td>@appointment.Patient.FirstName @appointment.Patient.LastName</td>
                                    }
                                    else
                                    {
                                        <td>Dr. @appointment.Dentist.FirstName @appointment.Dentist.LastName</td>
                                    }
                                    <td>@appointment.Service.Name</td>
                                    <td>@appointment.AppointmentDate.ToString("MMM dd, yyyy")</td>
                                    <td>@appointment.StartTime.Hours:@appointment.StartTime.Minutes.ToString("00")</td>
                                    <td>
                                        @if (appointment.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else if (appointment.Status == "Confirmed")
                                        {
                                            <span class="badge bg-success">Confirmed</span>
                                        }
                                        else if (appointment.Status == "Completed")
                                        {
                                            <span class="badge bg-primary">Completed</span>
                                        }
                                        else if (appointment.Status == "Cancelled")
                                        {
                                            <span class="badge bg-secondary">Cancelled</span>
                                        }
                                    </td>
                                    @if (User.IsInRole("Patient"))
                                    {
                                        <td>
                                            @if (appointment.Status == "Pending" || appointment.Status == "Confirmed")
                                            {
                                                <a asp-action="Cancel" asp-route-id="@appointment.Id" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-x-circle"></i> Cancel
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> 
            @if (User.IsInRole("Dentist"))
            {
                <text>No appointments found.</text>
            }
            else
            {
                <text>You don't have any appointments yet. <a asp-action="Book">Book your first appointment</a>!</text>
            }
        </div>
    }
</div>