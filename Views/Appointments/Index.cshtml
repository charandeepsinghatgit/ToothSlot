@model IEnumerable<ToothSlot.Models.Appointment>

@{
    ViewData["Title"] = "My Appointments";
}

<div class="container mt-4">
    @if(TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if(TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="bi bi-calendar-check"></i> My Appointments
        </h1>
        <a asp-action="Book" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Book New Appointment
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> You don't have any appointments yet. 
            <a asp-action="Book" class="alert-link">Book your first appointment</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var appointment in Model)
            {
                var isPast = appointment.AppointmentDate < DateTime.Now.Date;
                var statusBadge = appointment.Status switch
                {
                    "Pending" => "bg-warning text-dark",
                    "Confirmed" => "bg-success",
                    "Cancelled" => "bg-secondary",
                    "Completed" => "bg-info",
                    _ => "bg-secondary"
                };

                <div class="col-md-6 mb-3">
                    <div class="card @(isPast ? "opacity-75" : "")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">
                                    @appointment.Service?.Name
                                </h5>
                                <span class="badge @statusBadge">@appointment.Status</span>
                            </div>
                            
                            <p class="card-text">
                                <i class="bi bi-person-badge"></i> 
                                <strong>
                                    Dr. @appointment.Dentist?.FirstName @appointment.Dentist?.LastName
                                </strong>
                            </p>
                            
                            <p class="card-text">
                                <i class="bi bi-calendar3"></i> 
                                @appointment.AppointmentDate.ToString("MMMM dd, yyyy")
                                <br>
                                <i class="bi bi-clock"></i> @appointment.StartTime.ToString(@"hh\:mm")
                            </p>

                            @if (!string.IsNullOrEmpty(appointment.Notes))
                            {
                                <p class="card-text">
                                    <i class="bi bi-chat-left-text"></i> 
                                    <small class="text-muted">@appointment.Notes</small>
                                </p>
                            }

                            @if (appointment.Status == "Pending" && !isPast)
                            {
                                <form asp-action="Cancel" asp-route-id="@appointment.Id" 
                                      method="post" class="mt-2"
                                      onsubmit="return confirm('Are you sure you want to cancel this appointment?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-x-circle"></i> Cancel Appointment
                                    </button>
                                </form>
                            }
                            @if (appointment.Status == "Pending" && !isPast)
                            {
                                <div class="btn-group mt-2" role="group">
                                    <a asp-action="Reschedule" asp-route-id="@appointment.Id" 
                                       class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-calendar-event"></i> Reschedule
                                    </a>
                                    
                                    <form asp-action="Cancel" asp-route-id="@appointment.Id" 
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to cancel this appointment?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-x-circle"></i> Cancel
                                        </button>
                                    </form>
                                </div>
                            }
                            
                            @if (isPast)
                            {
                                <small class="text-muted">
                                    <i class="bi bi-clock-history"></i> Past appointment
                                </small>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>